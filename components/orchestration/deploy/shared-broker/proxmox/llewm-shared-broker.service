[Unit]
Description=Llewm shared messaging behind nginx
After=network.target

[Service]
Type=simple
User=llewm
Group=llewm
ExecStart=/opt/llewm/bin/llewm-orchestrate shared-broker-serve --db /var/lib/llewm-shared-broker/messages.db --listen 127.0.0.1:9469 --proxy-loopback
StateDirectory=llewm-shared-broker
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
NoNewPrivileges=true
# Avoid additional mount namespaces inside an unprivileged LXC guest.

[Install]
WantedBy=multi-user.target
