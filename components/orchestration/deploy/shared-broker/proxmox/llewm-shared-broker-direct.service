[Unit]
Description=Llewm shared messaging with direct TLS
After=network.target

[Service]
Type=simple
User=llewm
Group=llewm
ExecStart=/opt/llewm/bin/llewm-orchestrate shared-broker-serve --db /var/lib/llewm-shared-broker/messages.db --listen 0.0.0.0:9469 --tls-cert /etc/llewm/tls/fullchain.pem --tls-key /etc/llewm/tls/privkey.pem
StateDirectory=llewm-shared-broker
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
NoNewPrivileges=true
# Avoid additional mount namespaces inside an unprivileged LXC guest.

[Install]
WantedBy=multi-user.target
