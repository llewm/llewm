# Host-specific systemd configuration. No credential values belong here.
# The database must be initialized with shared-broker-init as the service user.
LLEWM_BROKER_DB=/var/lib/llewm-shared-broker/messages.db
# Replace loopback with the selected host's reachable address when deploying.
LLEWM_BROKER_LISTEN=127.0.0.1:9469
LLEWM_BROKER_TLS_CERT=/etc/llewm/tls/server.pem
LLEWM_BROKER_TLS_KEY=/etc/llewm/tls/server.key
